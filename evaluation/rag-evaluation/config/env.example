# Agent retrieval API. Use port 8085 for direct access or 8080 through gateway.
RAG_BASE_URL=http://localhost:8085
ADMIN_TOKEN=replace-with-admin-jwt

# Answer generation and RAGAS judge model. Any OpenAI-compatible chat endpoint works.
RAG_EVAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
RAG_EVAL_LLM_API_KEY=replace-with-dashscope-api-key
RAG_EVAL_LLM_MODEL=DeepSeek-v4-pro

# RAGAS answer-relevancy embedding model.
RAG_EVAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
RAG_EVAL_EMBEDDING_API_KEY=replace-with-dashscope-api-key
RAG_EVAL_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EVAL_EMBEDDING_DIM=1536
RAG_EVAL_MAX_WORKERS=2
