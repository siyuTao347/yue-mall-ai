# Copy to ../.env; literal KEY=value, no command substitution is evaluated.
# Application URL: direct mall-agent-service defaults to port 8085; a gateway also works.
CUSTOMER_EVAL_BASE_URL=http://127.0.0.1:8085
CUSTOMER_EVAL_MODE=mock
CUSTOMER_EVAL_HTTP_TIMEOUT=100
CUSTOMER_EVAL_INTERVAL=15.1

# Full Authorization values, e.g. Bearer <test-user-JWT>. Use dedicated test accounts.
CUSTOMER_EVAL_BUYER_TOKEN=
CUSTOMER_EVAL_SELLER_TOKEN=
CUSTOMER_EVAL_UNRELATED_TOKEN=
CUSTOMER_EVAL_ADMIN_TOKEN=

# Optional semantic judge: exact chat-completions endpoint, NOT only a base URL.
# This config does not change the model used by mall-agent-service.
CUSTOMER_EVAL_JUDGE_URL=
CUSTOMER_EVAL_JUDGE_MODEL=
CUSTOMER_EVAL_JUDGE_API_KEY=
CUSTOMER_EVAL_JUDGE_TIMEOUT=60

# Configured in mall-agent-service's environment, not used by this harness:
# CUSTOMER_SERVICE_PROVIDER=DASHSCOPE
# CUSTOMER_SERVICE_API_KEY=
# CUSTOMER_SERVICE_MASTER_MODEL=
# CUSTOMER_SERVICE_RESPONSE_MODEL=
# RAG_EMBEDDING_PROVIDER=OPENAI_COMPATIBLE
# RAG_EMBEDDING_BASE_URL=
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_MODEL=
# RAG_EMBEDDING_DIM=1536
